# ─── Supabase (Cloud) ────────────────────────────────────────────────────────
# Valores no Dashboard do projeto: Settings → API
# NEXT_PUBLIC_ prefix → exposed to browser bundle (safe: public keys only)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NO NEXT_PUBLIC_ prefix → server-only, NEVER expose to client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Server-only — NEVER import in 'use client' files or NEXT_PUBLIC_ vars
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Testes E2E (Playwright) ──────────────────────────────────────────────────
# Credenciais do utilizador de teste. auth.setup.ts autentica com
# signInWithPassword(E2E_EMAIL, E2E_PASSPHRASE) contra o Supabase real.
# Fonte única de verdade (carregada por playwright.config.ts):
#   - E2E_EMAIL      → .env.test (VERSIONADO, não-secreto)
#   - E2E_PASSPHRASE → .env.test.local (gitignored) localmente / secret no CI
# Para correr o E2E localmente, crie .env.test.local com:
#   E2E_PASSPHRASE=a-sua-palavra-passe-de-teste
# NUNCA ponha a passphrase em .env.test (é commitado e o repo é público).
