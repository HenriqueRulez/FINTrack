# ─── Supabase (Cloud) ────────────────────────────────────────────────────────
# Valores no Dashboard do projeto: Settings → API
# NEXT_PUBLIC_ prefix → exposed to browser bundle (safe: public keys only)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NO NEXT_PUBLIC_ prefix → server-only, NEVER expose to client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Server-only — NEVER import in 'use client' files or NEXT_PUBLIC_ vars
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Testes E2E (Playwright) ──────────────────────────────────────────────────
# Palavra-passe usada pelo QA automatizado para autenticar nos testes browser
E2E_PASSPHRASE=a-sua-palavra-passe
